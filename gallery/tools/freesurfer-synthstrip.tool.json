{
  "$schema": "../../../neuroflow-spec/schemas/0.1/tool.schema.json",
  "neuroflow": "0.1.0",
  "kind": "tool",
  "id": "neuroflow.gallery.tools/freesurfer-synthstrip",
  "version": "0.1.0",
  "description": "Skull-strip a brain MRI of any contrast or resolution with FreeSurfer's SynthStrip (mri_synthstrip). Writes the brain-only image and a binary brain mask, both on the input grid.",
  "inputs": {
    "t1": {
      "type": "neuro:volume",
      "description": "Full-head MRI, any contrast."
    },
    "border": {
      "type": "core:integer",
      "description": "Mask border in mm (SynthStrip's default is 1).",
      "optional": true,
      "default": 1
    },
    "no_csf": {
      "type": "core:boolean",
      "description": "Exclude CSF from the brain border.",
      "optional": true,
      "default": false
    },
    "threads": {
      "type": "core:integer",
      "description": "CPU threads (PyTorch's default when unset).",
      "optional": true
    }
  },
  "outputs": {
    "brain": {
      "type": "neuro:volume",
      "description": "Input image with everything outside the brain zeroed.",
      "delivery": {
        "mode": "core:result-dir",
        "path": "brain.nii.gz"
      }
    },
    "brain_mask": {
      "type": "neuro:mask",
      "description": "Binary brain mask on the input grid.",
      "delivery": {
        "mode": "core:result-dir",
        "path": "brain_mask.nii.gz"
      }
    }
  },
  "outputDelivery": {
    "default": "core:result-dir"
  },
  "extensions": {
    "niivue/ui": {
      "block": {
        "id": "freesurfer-synthstrip",
        "label": "Brain extraction (SynthStrip)",
        "description": "Skull-strip with FreeSurfer SynthStrip.",
        "category": "Processing",
        "stage": "explore",
        "exposedFields": [
          "border",
          "no_csf"
        ]
      }
    },
    "neuroflow/launch": {
      "kind": "script",
      "interpreter": "node",
      "script": "../scripts/cli_tool.mjs",
      "completion": "exit",
      "interactive": false,
      "contract": "../../docs/neuroflow-session-contract.md",
      "requirements": [
        "FreeSurfer 7.3 or newer (no license needed for this tool); under /Applications/freesurfer/*, /usr/local/freesurfer*, or FREESURFER_HOME"
      ],
      "description": "Runs mri_synthstrip -i <t1> -o brain.nii.gz -m brain_mask.nii.gz -b <border> [--no-csf] through the shared native CLI adapter."
    },
    "neuroflow/mcp": {
      "title": "Brain extraction (FreeSurfer SynthStrip)",
      "annotations": {
        "idempotentHint": true
      },
      "maxWaitMs": 900000
    },
    "neuroflow/cli": {
      "command": "mri_synthstrip",
      "paths": [
        "/Applications/freesurfer/*/bin/mri_synthstrip",
        "/usr/local/freesurfer/*/bin/mri_synthstrip",
        "/usr/local/freesurfer/bin/mri_synthstrip",
        "~/freesurfer/bin/mri_synthstrip"
      ],
      "env": "MRI_SYNTHSTRIP",
      "homeEnv": "FREESURFER_HOME",
      "probe": {
        "args": [
          "--help"
        ],
        "match": "--mask",
        "advice": "This FreeSurfer has no usable mri_synthstrip; install FreeSurfer 7.3 or newer."
      },
      "args": [
        "-i",
        "{{t1}}",
        "-o",
        "{{outputDir}}/brain.nii.gz",
        "-m",
        "{{outputDir}}/brain_mask.nii.gz",
        "-b",
        "{{border}}",
        {
          "arg": "--no-csf",
          "when": {
            "no_csf": true
          }
        },
        {
          "args": [
            "-t",
            "{{threads}}"
          ],
          "whenSet": "threads"
        }
      ],
      "outputs": {
        "brain": "brain.nii.gz",
        "brain_mask": "brain_mask.nii.gz"
      },
      "source": "https://w3id.org/synthstrip (Hoopes et al., NeuroImage 2022)"
    },
    "neuroflow/usage": {
      "useWhen": [
        "Skull-strip a head MRI of any contrast (T1, T2, FLAIR, PD, CT) with FreeSurfer's SynthStrip.",
        "Show a FreeSurfer tool running locally on a volume in a couple of minutes or less."
      ],
      "avoidWhen": [
        {
          "when": "You want the fastest local skull-strip and brainchop is installed.",
          "instead": "neuroflow.gallery.tools/mindgrab"
        },
        {
          "when": "The image is already skull-stripped."
        }
      ],
      "preconditions": [
        "FreeSurfer 7.3 or newer installed (mri_synthstrip).",
        "t1 is a full-head NIfTI volume."
      ],
      "effects": [
        "Writes brain.nii.gz and brain_mask.nii.gz to the output directory, both on the input grid."
      ],
      "duration": {
        "typicalSeconds": 30,
        "basis": "One run on an Apple-silicon Mac (CPU, FreeSurfer dev 2024-03): 29 s for a 0.88 mm T1."
      },
      "examples": [
        {
          "title": "Skull-strip a T1",
          "inputs": {
            "t1": "<t1>"
          }
        },
        {
          "title": "Tight mask without CSF",
          "inputs": {
            "t1": "<t1>",
            "no_csf": true
          }
        }
      ],
      "failures": [
        {
          "match": {
            "contains": "mri_synthstrip was not found"
          },
          "meaning": "No FreeSurfer install with this command was found.",
          "remedy": "Install FreeSurfer 7.3 or newer, or set MRI_SYNTHSTRIP to the command's path.",
          "retry": "after-fix"
        },
        {
          "match": {
            "contains": "mri_synthstrip exited with status"
          },
          "meaning": "mri_synthstrip failed on this image.",
          "remedy": "Read the step log, and check that t1 is a readable NIfTI with neuroflow_inspect.",
          "retry": "after-fix"
        }
      ]
    }
  }
}
