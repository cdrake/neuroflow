{
  "$schema": "../../../neuroflow-spec/schemas/0.1/tool.schema.json",
  "neuroflow": "0.1.0",
  "kind": "tool",
  "id": "neuroflow.gallery.tools/label-volumes",
  "version": "0.1.0",
  "description": "Measure the volume of every label in a segmentation (FreeSurfer names for SynthSeg/FreeSurfer label ids) and, optionally, of a brain mask. Writes a TSV and returns the same table inline so an agent can answer volume questions directly.",
  "inputs": {
    "labels": {
      "type": "neuro:label-map",
      "description": "Integer label map, e.g. SynthSeg output."
    },
    "mask": {
      "type": "neuro:mask",
      "description": "Optional brain mask; its volume is reported as brain_mask_ml.",
      "optional": true
    }
  },
  "outputs": {
    "volumes": {
      "type": "core:tabular",
      "description": "label, name, voxels, volume_ml.",
      "delivery": {
        "mode": "core:result-dir",
        "path": "volumes.tsv"
      }
    },
    "table": {
      "type": "core:json",
      "description": "Same rows plus totals, inline.",
      "delivery": {
        "mode": "core:result-file"
      }
    }
  },
  "outputDelivery": {
    "default": "core:result-dir"
  },
  "extensions": {
    "niivue/ui": {
      "block": {
        "id": "label-volumes",
        "label": "Label Volumes",
        "description": "Per-structure volumes in mL.",
        "category": "Output",
        "stage": "publish",
        "exposedFields": []
      }
    },
    "neuroflow/launch": {
      "kind": "script",
      "interpreter": "node",
      "script": "../scripts/python_tool.mjs",
      "completion": "exit",
      "interactive": false,
      "contract": "../../docs/neuroflow-session-contract.md",
      "requirements": [
        "Python 3.10+ with nibabel and numpy; set NEUROFLOW_PYTHON to the environment"
      ],
      "description": "python_tool.mjs checks the Python environment, then calls nf_label_volumes.run(labels, mask); volumes.tsv lands in the output dir and the returned table in $NEUROFLOW_OUTPUT_FILE."
    },
    "neuroflow/python": {
      "interpreter": {
        "env": "NEUROFLOW_PYTHON",
        "paths": [
          "{{toolDir}}/.venv/bin/python",
          "~/.venvs/neuroflow/bin/python"
        ],
        "minVersion": "3.10"
      },
      "requirements": [
        "nibabel",
        "numpy"
      ],
      "singleThread": true,
      "entry": {
        "kind": "function",
        "module": "nf_label_volumes",
        "name": "run",
        "args": [
          "{{labels}}",
          "{{mask}}"
        ],
        "result": "table"
      },
      "outputs": {
        "volumes": "volumes.tsv"
      }
    },
    "neuroflow/mcp": {
      "title": "Label volumes (mL per structure)",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true
      }
    }
  }
}
