{
  "$schema": "../../../neuroflow-spec/schemas/0.1/workflow.schema.json",
  "neuroflow": "0.1.0",
  "kind": "workflow",
  "id": "neuroflow.gallery/dicom-t1-mni-volumes",
  "version": "0.1.0",
  "description": "From one T1-weighted DICOM series to structure volumes and an MNI-space brain, using the lightNIIng tool set: dcm2niix conversion, mindgrab (brainchop) skull stripping, niimath -allineate affine registration of the brain to an MNI152 brain template, SynthSeg whole-brain segmentation of the full-head T1 (native space), and per-structure volumes in mL. This is the reference answer for demos/prompt-to-workflow.",
  "inputs": {
    "dicom_dir": {
      "type": "neuro:dicom-folder",
      "description": "DICOM folder holding one T1-weighted series."
    },
    "template": {
      "type": "neuro:volume",
      "description": "Skull-stripped MNI152 T1 template (for example MNI152_T1_1mm_brain.nii.gz)."
    },
    "mode": {
      "type": "core:string",
      "description": "SynthSeg mode.",
      "optional": true,
      "default": "default",
      "enum": [
        "default",
        "fast"
      ]
    }
  },
  "steps": {
    "convert": {
      "tool": "neuroflow.gallery.tools/dcm2niix",
      "stage": "ingest",
      "inputs": {
        "dicom_dir": {
          "ref": "inputs.dicom_dir"
        }
      }
    },
    "strip": {
      "tool": "neuroflow.gallery.tools/mindgrab",
      "stage": "explore",
      "inputs": {
        "t1": {
          "ref": "steps.convert.outputs.volume"
        }
      }
    },
    "register": {
      "tool": "neuroflow.gallery.tools/niimath-allineate",
      "stage": "explore",
      "inputs": {
        "moving": {
          "ref": "steps.strip.outputs.brain"
        },
        "template": {
          "ref": "inputs.template"
        }
      }
    },
    "segment": {
      "tool": "neurodesk.webapps/synthseg",
      "stage": "explore",
      "inputs": {
        "t1": {
          "ref": "steps.convert.outputs.volume"
        },
        "mode": {
          "ref": "inputs.mode"
        }
      }
    },
    "volumes": {
      "tool": "neuroflow.gallery.tools/label-volumes",
      "stage": "publish",
      "inputs": {
        "labels": {
          "ref": "steps.segment.outputs.labels"
        },
        "mask": {
          "ref": "steps.strip.outputs.brain_mask"
        }
      }
    }
  },
  "outputs": {
    "t1": {
      "type": "neuro:volume",
      "ref": "steps.convert.outputs.volume"
    },
    "sidecar": {
      "type": "core:json",
      "ref": "steps.convert.outputs.sidecar"
    },
    "brain": {
      "type": "neuro:volume",
      "ref": "steps.strip.outputs.brain"
    },
    "brain_mask": {
      "type": "neuro:mask",
      "ref": "steps.strip.outputs.brain_mask"
    },
    "brain_mni": {
      "type": "neuro:volume",
      "ref": "steps.register.outputs.registered"
    },
    "to_mni": {
      "type": "neuro:transform",
      "ref": "steps.register.outputs.transform"
    },
    "labels": {
      "type": "neuro:label-map",
      "ref": "steps.segment.outputs.labels"
    },
    "volumes": {
      "type": "core:tabular",
      "ref": "steps.volumes.outputs.volumes"
    },
    "table": {
      "type": "core:json",
      "ref": "steps.volumes.outputs.table"
    }
  },
  "extensions": {
    "neuroflow/mcp": {
      "title": "DICOM T1 to MNI brain and structure volumes (lightNIIng tools)",
      "maxWaitMs": 900000
    }
  }
}
