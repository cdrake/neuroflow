{
  "$schema": "../../../neuroflow-spec/schemas/0.1/workflow.schema.json",
  "neuroflow": "0.1.0",
  "kind": "workflow",
  "id": "neuroflow.gallery/freesurfer-brain-volumes",
  "version": "0.1.0",
  "description": "Headless brain volumes from one T1-weighted scan with a local FreeSurfer install: SynthStrip brain extraction and SynthSeg whole-brain segmentation (FreeSurfer's mri_synthstrip and mri_synthseg), then per-structure volumes in mL and the brain-mask volume. Every step is a plain command line, so it runs unattended over MCP or on a compute node.",
  "inputs": {
    "t1": {
      "type": "neuro:volume",
      "description": "Full-head T1-weighted NIfTI image."
    },
    "mode": {
      "type": "core:string",
      "description": "SynthSeg mode.",
      "optional": true,
      "default": "default",
      "enum": [
        "default",
        "fast",
        "robust"
      ]
    },
    "threads": {
      "type": "core:integer",
      "description": "CPU threads for SynthStrip and SynthSeg.",
      "optional": true,
      "default": 4
    }
  },
  "steps": {
    "strip": {
      "tool": "neuroflow.gallery.tools/freesurfer-synthstrip",
      "stage": "explore",
      "inputs": {
        "t1": {
          "ref": "inputs.t1"
        },
        "threads": {
          "ref": "inputs.threads"
        }
      }
    },
    "segment": {
      "tool": "neuroflow.gallery.tools/freesurfer-synthseg",
      "stage": "explore",
      "inputs": {
        "t1": {
          "ref": "inputs.t1"
        },
        "mode": {
          "ref": "inputs.mode"
        },
        "threads": {
          "ref": "inputs.threads"
        }
      }
    },
    "volumes": {
      "tool": "neuroflow.gallery.tools/label-volumes",
      "stage": "publish",
      "inputs": {
        "labels": {
          "ref": "steps.segment.outputs.labels"
        },
        "mask": {
          "ref": "steps.strip.outputs.brain_mask"
        }
      }
    }
  },
  "outputs": {
    "brain": {
      "type": "neuro:volume",
      "ref": "steps.strip.outputs.brain"
    },
    "brain_mask": {
      "type": "neuro:mask",
      "ref": "steps.strip.outputs.brain_mask"
    },
    "labels": {
      "type": "neuro:label-map",
      "ref": "steps.segment.outputs.labels"
    },
    "synthseg_volumes": {
      "type": "core:tabular",
      "ref": "steps.segment.outputs.volumes"
    },
    "volumes": {
      "type": "core:tabular",
      "ref": "steps.volumes.outputs.volumes"
    },
    "table": {
      "type": "core:json",
      "ref": "steps.volumes.outputs.table"
    }
  },
  "extensions": {
    "neuroflow/mcp": {
      "title": "Brain volumes (FreeSurfer SynthStrip + SynthSeg)",
      "maxWaitMs": 1800000
    }
  }
}
