{
  "$schema": "../../../neuroflow-spec/schemas/0.1/workflow.schema.json",
  "neuroflow": "0.1.0",
  "kind": "workflow",
  "id": "neuroflow.gallery/brain-volumes",
  "version": "0.1.0",
  "description": "Brain volumes from one T1-weighted scan: brain extraction (SynthStrip by default) and SynthSeg whole-brain segmentation, both from Neurodesk Webapps, then per-structure volumes in mL (for example left and right hippocampus) and the brain-mask volume.",
  "inputs": {
    "t1": {
      "type": "neuro:volume",
      "description": "Full-head T1-weighted NIfTI image."
    },
    "method": {
      "type": "core:string",
      "description": "Brain extraction method.",
      "optional": true,
      "default": "synthstrip",
      "enum": [
        "synthstrip",
        "mindgrab",
        "bet"
      ]
    },
    "mode": {
      "type": "core:string",
      "description": "SynthSeg mode.",
      "optional": true,
      "default": "default",
      "enum": [
        "default",
        "fast"
      ]
    }
  },
  "steps": {
    "strip": {
      "tool": "neurodesk.webapps/brain-extraction",
      "stage": "explore",
      "inputs": {
        "t1": {
          "ref": "inputs.t1"
        },
        "method": {
          "ref": "inputs.method"
        }
      }
    },
    "segment": {
      "tool": "neurodesk.webapps/synthseg",
      "stage": "explore",
      "inputs": {
        "t1": {
          "ref": "inputs.t1"
        },
        "mode": {
          "ref": "inputs.mode"
        }
      }
    },
    "volumes": {
      "tool": "neuroflow.gallery.tools/label-volumes",
      "stage": "publish",
      "inputs": {
        "labels": {
          "ref": "steps.segment.outputs.labels"
        },
        "mask": {
          "ref": "steps.strip.outputs.brain_mask"
        }
      }
    }
  },
  "outputs": {
    "brain": {
      "type": "neuro:volume",
      "ref": "steps.strip.outputs.brain"
    },
    "brain_mask": {
      "type": "neuro:mask",
      "ref": "steps.strip.outputs.brain_mask"
    },
    "labels": {
      "type": "neuro:label-map",
      "ref": "steps.segment.outputs.labels"
    },
    "volumes": {
      "type": "core:tabular",
      "ref": "steps.volumes.outputs.volumes"
    },
    "table": {
      "type": "core:json",
      "ref": "steps.volumes.outputs.table"
    }
  },
  "extensions": {
    "neuroflow/mcp": {
      "title": "Brain volumes (Neurodesk SynthStrip + SynthSeg)",
      "maxWaitMs": 900000
    }
  }
}
