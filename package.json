{
  "name": "neuroflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "wasm:build": "wasm-pack build crates/neuroflow-wasm --target web --out-dir ../../src/wasm",
    "validate:gallery": "node gallery/validate.mjs",
    "test:gallery": "node --test \"gallery/scripts/*.test.mjs\"",
    "slides": "marp --server docs",
    "slides:watch": "marp --watch --preview docs/stages.slides.md",
    "slides:html": "marp docs/stages.slides.md --html -o docs/stages.slides.html",
    "slides:pdf": "marp docs/stages.slides.md --pdf --allow-local-files -o docs/stages.slides.pdf"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.1.2",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.2",
    "vite": "^5.4.11",
    "wasm-pack": "^0.13.1"
  }
}
